<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:paddingVertical="28dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- 💳 Card Centralizado com Ajuste de Margem para Sombra Respirar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <!-- ♻️ Ícone de Reciclagem -->
            <ImageView
                android:id="@+id/image_recyclable"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_recycling"
                tools:app_tint="#D32F2F"
                android:contentDescription="Material" />

            <!-- Nome do Material -->
            <TextView
                android:id="@+id/text_nome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#14171A"
                tools:text="Plástico (Vermelho)" />

            <!-- Linha Divisória Sutil -->
            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="#E2E8F0"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

            <!-- ⏰ Painel de Decomposição -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tempo de Decomposição"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#657786"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/text_decomp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                tools:text="400 anos" />

            <!-- 💡 Bloco de Curiosidade -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Você sabia?"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#657786"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/text_curiosity_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#4A5568"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.3"
                tools:text="Grande parte do plástico vem de embalagens PET e garrafas. É o mais comum." />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>